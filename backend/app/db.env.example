# Copy this file to db.env for local development:
#   cp db.env.example db.env
# db.env is gitignored — it's never committed.
#
# These defaults match the local MySQL container started by
# `docker compose up -d` at the repo root.

DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=streamer_social
DB_PASSWORD=localdev
DB_NAME=streamer_social

# Generate your own key for local use — do NOT reuse the production key here,
# your local database is a separate, disposable one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
