# Copy this file to user_oauth.env for local development:
#   cp user_oauth.env.example user_oauth.env
# user_oauth.env is gitignored — it's never committed.

# Reuse your existing Twitch app's Client ID/Secret from
# https://dev.twitch.tv/console/apps — Twitch apps support multiple OAuth
# Redirect URLs, so just add this one alongside your production one:
#   http://localhost:8000/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/auth/twitch/callback

# The local frontend dev server (Vite's default port).
FRONTEND_BASE_URL=http://localhost:5173

# Any string — only used to authenticate calls between this backend process
# and its own EventSub tracker thread, doesn't need to match production.
INTERNAL_API_KEY=local-dev-key

# IMPORTANT: without this, the tracker thread reports redemption/stream
# events to the *production* Railway backend instead of this local one
# (it's what BACKEND_INTERNAL_URL defaults to). Always set it when running
# locally, or your local dashboard will never see live updates.
BACKEND_INTERNAL_URL=http://localhost:8000
