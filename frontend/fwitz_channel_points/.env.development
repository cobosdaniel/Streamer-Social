# Default target for `npm run dev` — the live Railway backend.
# To point your local frontend at a local backend instead, create
# .env.development.local (see .env.development.local.example) — Vite
# gives that file priority over this one, and it's gitignored so you
# never have to touch this file to switch back and forth.
VITE_API_URL=https://streamer-social-production.up.railway.app
