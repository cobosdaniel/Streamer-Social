# Copy this file to .env.development.local to point `npm run dev` at your
# local backend instead of the live Railway one:
#   cp .env.development.local.example .env.development.local
# .env.development.local is gitignored (matches the *.local pattern) and
# overrides .env.development, so this is the entire "cycle" mechanism —
# nothing else to flip. Delete the file (or comment out the line) to go
# back to testing against Railway.
VITE_API_URL=http://localhost:8000
